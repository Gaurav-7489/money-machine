# Copy to .env.local. Never commit real values.
# Not required for the current UI preview build.
DATABASE_URL=
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: a free GIPHY API key (developers.giphy.com) lets people search all of
# GIPHY from the GIF picker. Without it the picker searches the built-in library.
NEXT_PUBLIC_GIPHY_API_KEY=
